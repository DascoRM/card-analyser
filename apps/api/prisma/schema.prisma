// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===== ENUMS =====

enum SessionStatus {
  PENDING
  UPLOADING
  ANALYZING
  COMPLETED
  FAILED
  ARCHIVED
}

enum CardSide {
  FRONT
  BACK
}

enum GradeScale {
  PCA
  PSA
}

// ===== MODELS =====

model User {
  id        Int             @id @default(autoincrement())
  email     String          @unique
  name      String?
  sessions  Session[]
  feedbacks GradeFeedback[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Session {
  id          String        @id @default(uuid())
  userId      Int
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Métadonnées de la carte
  cardName    String?
  cardSet     String?
  cardYear    Int?
  cardType    String?
  cardNumber  String?       // Ex: "025/102"
  cardRarity  String?       // Ex: "Rare Holo"
  cardArtist  String?       // Nom de l'artiste
  cardImageUrl String?      // URL image de référence

  // Métadonnées d'identification
  identificationConfidence Float?    // Score de confiance 0-1
  identificationMethod     String?   // "ocr", "manual", "api"
  pokemonTcgApiId          String?   // ID externe PokémonTCG API

  // État de la session
  status      SessionStatus @default(PENDING)

  // Relations
  images       SessionImage[]
  gradeResults GradeResult[]

  // Timestamps
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  completedAt DateTime?

  @@index([userId, status])
  @@index([createdAt])
}

model SessionImage {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Informations image
  side      CardSide
  url       String
  filename  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?

  // Timestamps
  uploadedAt DateTime @default(now())

  @@index([sessionId])
}

model GradeResult {
  id           String          @id @default(uuid())
  sessionId    String
  session      Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Type de grading
  scale        GradeScale

  // Scores détaillés (1-10)
  centering    Float
  corners      Float
  edges        Float
  surface      Float
  printQuality Float

  // Note finale
  finalGrade   Float
  gradeLabel   String

  // Confiance du modèle ML
  confidence   Float?
  modelVersion String?
  analysisData Json?

  // Relations
  feedbacks    GradeFeedback[]

  // Timestamps
  createdAt    DateTime        @default(now())

  @@index([sessionId])
}

model GradeFeedback {
  id           String      @id @default(uuid())
  resultId     String
  result       GradeResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  userId       Int
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Corrections proposées par l'utilisateur (1-10)
  centering    Float
  corners      Float
  edges        Float
  surface      Float
  printQuality Float

  // Commentaire optionnel
  comment      String?

  // Timestamps
  createdAt    DateTime    @default(now())

  @@index([resultId])
  @@index([userId])
}
